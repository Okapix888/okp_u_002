    behaviors {
        myholdtap1: myholdtap1 {
            compatible = "zmk,behavior-hold-tap";
            label = "MYHOLDTAP1";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        myTBMHZH: myTBMHZH {
            compatible = "zmk,behavior-tap-dance";
            label = "MYTBMHZH";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_5>, <&kp GRAVE>;
        };

        myHome: myHome {
            compatible = "zmk,behavior-tap-dance";
            label = "MYHOME";
            #binding-cells = <0>;
            bindings =
                <&kp HOME>,
                <&kp LC(PAGE_UP)>,
                <&kp LA(LEFT_ARROW)>,
                <&kp LC(LS(TAB))>;

            tapping-term-ms = <250>;
        };

        myEnd: myEnd {
            compatible = "zmk,behavior-tap-dance";
            label = "MYEND";
            #binding-cells = <0>;
            bindings =
                <&kp END>,
                <&kp LC(PAGE_DOWN)>,
                <&kp LA(RIGHT_ARROW)>,
                <&kp LC(TAB)>;

            tapping-term-ms = <200>;
        };

        myKakkoHiraku: myKakkoHiraku {
            compatible = "zmk,behavior-tap-dance";
            label = "MYKAKKOHIRAKU";
            #binding-cells = <0>;
            bindings =
                <&kp LS(NUMBER_8)>,
                <&kp RIGHT_BRACKET>,
                <&kp LS(RIGHT_BRACKET)>;
        };

        myKakkoTojiru: myKakkoTojiru {
            compatible = "zmk,behavior-tap-dance";
            label = "MYKAKKOTOJIRU";
            #binding-cells = <0>;
            bindings = <&kp LS(N9)>, <&kp BACKSLASH>, <&kp LS(BACKSLASH)>;
        };
    };


    behaviors {
        myholdtap1: myholdtap1 {
            compatible = "zmk,behavior-hold-tap";
            label = "MYHOLDTAP1";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        myTBMHZH: myTBMHZH {
            compatible = "zmk,behavior-tap-dance";
            label = "MYTBMHZH";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_5>, <&kp GRAVE>;
        };
    };

    macros {

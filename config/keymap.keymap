    behaviors {
        myholdtap1: myholdtap1 {
            compatible = "zmk,behavior-hold-tap";
            label = "MYHOLDTAP1";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
        };

        myTBMHZH: myTBMHZH {
            compatible = "zmk,behavior-tap-dance";
            label = "MYTBMHZH";
            #binding-cells = <0>;
            bindings = <&kp INTERNATIONAL_5>, <&kp GRAVE>;
        };

        myHome: myHome {
            compatible = "zmk,behavior-tap-dance";
            label = "MYHOME";
            #binding-cells = <0>;
            bindings =
                <&kp HOME>,
                <&kp LC(PAGE_UP)>,
                <&kp LA(LEFT_ARROW)>,
                <&kp LC(LS(TAB))>;

            tapping-term-ms = <300>;
        };

        myEnd: myEnd {
            compatible = "zmk,behavior-tap-dance";
            label = "MYEND";
            #binding-cells = <0>;
            bindings =
                <&kp END>,
                <&kp LC(PAGE_DOWN)>,
                <&kp LA(RIGHT_ARROW)>,
                <&kp LC(TAB)>;

            tapping-term-ms = <300>;
        };

        myKakkoHiraku: myKakkoHiraku {
            compatible = "zmk,behavior-tap-dance";
            label = "MYKAKKOHIRAKU";
            #binding-cells = <0>;
            bindings =
                <&kp LS(NUMBER_8)>,
                <&kp RIGHT_BRACKET>,
                <&kp LS(RIGHT_BRACKET)>;

            tapping-term-ms = <300>;
        };

        myKakkoTojiru: myKakkoTojiru {
            compatible = "zmk,behavior-tap-dance";
            label = "MYKAKKOTOJIRU";
            #binding-cells = <0>;
            bindings = <&kp LS(N9)>, <&kp BACKSLASH>, <&kp LS(BACKSLASH)>;

            tapping-term-ms = <300>;
        };

        test_tap: test_tap {
            compatible = "zmk,behavior-tap-dance";
            label = "TEST_TAP";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1>, <&kp NUMBER_2>;
        };

        test_holdtap: test_holdtap {
            compatible = "zmk,behavior-hold-tap";
            label = "TEST_HOLDTAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <128>;
            bindings = <&mo>, <&test_tap>;
        };

        myholdtap_lowspeed: myholdtap_lowspeed {
            compatible = "zmk,behavior-hold-tap";
            label = "MYHOLDTAP_LOWSPEED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "balanced";
            require-prior-idle-ms = <128>;
        };
    };


            bindings = <&kp D &kp I>;
            label = "MC_OS_DI";
        };

        mc_os_du: mc_os_du {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp U>;
            label = "MC_OS_DU";
        };

        mc_os_de: mc_os_de {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp E>;
            label = "MC_OS_DE";
        };

        mc_os_do: mc_os_do {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp O>;
            label = "MC_OS_DO";
        };

        mc_os_ba: mc_os_ba {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp A>;
            label = "MC_OS_BA";
        };

        mc_os_bi: mc_os_bi {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp I>;
            label = "MC_OS_BI";
        };

        mc_os_bu: mc_os_bu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp U>;
            label = "MC_OS_BU";
        };

        mc_os_be: mc_os_be {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp E>;
            label = "MC_OS_BE";
        };

        mc_os_bo: mc_os_bo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp O>;
            label = "MC_OS_BO";
        };

        cb_os_on: cb_os_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG4 &to 0>;
            label = "CB_OS_ON";
        };

        mc_os_xtu: mc_os_xtu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp T &kp U>;
            label = "MC_OS_XTU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_4 {
            bindings = <
&kp PERIOD  &mc_os_ka  &mc_os_ta  &mc_os_ko  &mc_os_sa         &kp NUMBER_0  &mc_os_ra  &mc_os_ti  &mc_os_ku  &mc_os_tu     &kp COMMA
&kp U       &mc_os_si  &mc_os_te  &mc_os_ke  &mc_os_se         &kp C_MUTE    &mc_os_ha  &mc_os_to  &mc_os_ki  &kp I         &mc_os_nn
&kp PERIOD  &mc_os_hi  &mc_os_su  &mc_os_hu  &mc_os_he         &kp K_MUTE2   &mc_os_me  &mc_os_so  &mc_os_ne  &mc_os_ho     &kp SLASH
&kp TAB     &kp LG(L)  &mo 4      &mo 3      &kp INT_MUHENKAN                &kp SPACE  &mo 2      &mo 1      &kp LEFT_GUI  &myholdtap1 LEFT_ALT ENTER
            >;
        };

        layer_0 {
            bindings = <
&kp Q      &kp W   &kp E                       &kp R                     &kp T             &kp NUMBER_1  &kp Y                &kp U                      &kp I                       &kp O       &kp P
&kp A      &kp S   &myholdtap1 LEFT_CONTROL D  &myholdtap1 LEFT_SHIFT F  &kp G             &none         &kp H                &myholdtap1 RIGHT_SHIFT J  &myholdtap1 LEFT_CONTROL K  &kp L       &kp SPACE
&kp Z      &kp X   &kp C                       &kp V                     &kp B             &none         &kp N                &kp M                      &kp COMMA                   &kp PERIOD  &kp MINUS
&lt 4 TAB  &trans  &mo 4                       &lt 3 B                   &kp INT_MUHENKAN                &kp INTERNATIONAL_4  &lt 2 N                    &none                       &trans      &mt LEFT_ALT ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE  &kp LC(W)  &kp LC(E)                       &kp LC(R)                     &kp F5             &kp NUMBER_2  &kp LC(Y)  &kp LC(U)  &kp LC(I)  &kp LC(O)  &kp LC(P)
&kp LC(A)   &kp LC(S)  &myholdtap1 LEFT_CONTROL LC(D)  &myholdtap1 LEFT_SHIFT LC(F)  &kp K_APPLICATION  &none         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp LC(SPACE)
&kp LC(Z)   &kp LC(X)  &kp LC(C)                       &kp LC(V)                     &kp LC(B)          &none         &kp LC(N)  &kp TAB    &myHome    &myEnd     &kp LS(SPACE)
&kp TAB     &trans     &none                           &kp F2                        &myTBMHZH                        &none      &none      &none      &trans     &mt RIGHT_ALT ENTER
            >;
        };

        layer_2 {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp RS(NUMBER_3)  &kp LS(NUMBER_4)                     &kp EQUAL         &kp NUMBER_3  &kp LS(SEMICOLON)        &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp LS(INT_YEN)
&kp SEMICOLON     &myKakkoHiraku    &myKakkoTojiru    &myholdtap1 LEFT_SHIFT SINGLE_QUOTE  &kp LS(NUMBER_5)  &none         &kp MINUS                &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp LS(SINGLE_QUOTE)
&kp LEFT_BRACKET  &none             &kp LC(NUMBER_1)  &kp LS(INTERNATIONAL_1)              &kp LS(NUMBER_6)  &none         &kp LS(INTERNATIONAL_3)  &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp SLASH
&kp TAB           &none             &none             &none                                &none                           &kp PERIOD               &kp NUMBER_0  &kp LS(MINUS)  &none         &mt RIGHT_ALT ENTER
            >;
        };

        layer_3 {
            bindings = <
&kp F1           &kp F2          &kp F3     &kp F4     &kp F5           &kp NUMBER_4  &kp F6          &kp F7          &kp F8        &kp F9           &kp F10
&kp F11          &kp F12         &mkp RCLK  &mkp LCLK  &kp NON_US_HASH  &none         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&kp PRINTSCREEN  &none           &none      &none      &none            &none         &none           &none           &msc SCRL_UP  &msc SCRL_DOWN   &none
&kp TAB          &kp LEFT_SHIFT  &none      &none      &none                          &none           &none           &none         &none            &mt RIGHT_ALT ENTER
            >;
        };
    };
};
